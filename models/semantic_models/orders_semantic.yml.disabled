semantic_models:
  - name: orders

    model: ref('fct_orders')

    defaults:
      agg_time_dimension: order_date

    entities:
      - name: order_id
        type: primary

      - name: customer_id
        type: foreign

      - name: product_id
        type: foreign

    dimensions:
      - name: order_date
        type: time

        expr: order_date

        type_params:
          time_granularity: day

      - name: status
        type: categorical

    measures:
      - name: total_revenue
        description: Total order revenue
        agg: sum
        expr: amount

      - name: total_orders
        description: Count of orders
        agg: count

      - name: total_quantity
        agg: sum
        expr: quantity